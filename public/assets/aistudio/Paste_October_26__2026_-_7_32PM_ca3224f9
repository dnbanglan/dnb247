            <p>[12:00:01 PM] 1920x1920 PhotoCard Engine initialized successfully.</p>
          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- JAVASCRIPT LOGIC -->
  <script>
    let defaultAds = [
      { id: 'ad-1', name: 'নিউ ক্লাসিক ইভেন্ট ম্যানেজমেন্ট', desc: 'হলুদের স্টেজ, বউভাত | 01945544242', image: 'https://images.unsplash.com/photo-1519741497674-611481863552?w=800' },
      { id: 'ad-2', name: 'bKash Merchant Offer', desc: 'প্রতিদিন ক্যাশব্যাক অফার।', image: 'https://images.unsplash.com/photo-1556742049-0a67d553c2c5?w=800' },
      { id: 'ad-3', name: 'Nagad Digital Service', desc: 'সবচেয়ে কম খরচে সেন্ড মানি।', image: 'https://images.unsplash.com/photo-1563986768609-322da13575f3?w=800' }
    ];

    const AD_STORAGE_KEY = 'dnbangla_local_ads';
    const MAX_AD_IMAGE_BYTES = 2 * 1024 * 1024;

    function loadAdBanners() {
      try {
        const saved = localStorage.getItem(AD_STORAGE_KEY);
        if (!saved) return [...defaultAds];
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed) && parsed.length > 0 && parsed.every(ad =>
          ad && typeof ad.name === 'string' && typeof ad.desc === 'string' &&
          typeof ad.image === 'string' && /^(https:\/\/|data:image\/)/i.test(ad.image)
        )) return parsed;
      } catch (error) {
        console.warn('Saved ad data could not be read.', error);
      }
      return [...defaultAds];
    }

    function saveAdBanners() {
      try {
        localStorage.setItem(AD_STORAGE_KEY, JSON.stringify(adBanners));
        return true;
      } catch (error) {
        console.warn('Saved ad data could not be written.', error);
        showToast('ব্রাউজারের স্টোরেজ পূর্ণ। ছোট ছবি ব্যবহার করুন বা কিছু বিজ্ঞাপন মুছুন।', 'error');
        return false;
      }
    }

    let adBanners = loadAdBanners();
    let currentAdIndex = 0;
    let textAdIndex = 0;
    let adImageObjs = {};
    let bgImageObj = null;
    let toastTimer = null;

    window.onload = function() {
      initAdDropdown();
      renderAdList();
      document.getElementById('topbar-ad-name').textContent = adBanners[0]?.name || 'কোনো বিজ্ঞাপন নেই';
      preloadAdImages();
      handleAutoDateToggle();
      updateTextTriggerColorControls();
      drawCanvas();
      drawTextTriggerCanvas();
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => {
          drawCanvas();
          drawTextTriggerCanvas();
        });
      }
    };

    function preloadAdImages() {
      adImageObjs = {};
      adBanners.forEach((ad, idx) => {
        let img = new Image();
        if (!ad.image.startsWith('data:')) img.crossOrigin = "anonymous";
        img.onload = function() {
          adImageObjs[idx] = img;
          drawCanvas();
        };
        img.onerror = function() {
          delete adImageObjs[idx];
          drawCanvas();
        };
        img.src = ad.image;
      });
    }

    function drawImageCover(ctx, image, x, y, width, height) {
      if (!image || !image.width || !image.height) return;
      const scale = Math.max(width / image.width, height / image.height);
      const sourceWidth = width / scale;
      const sourceHeight = height / scale;
      const sourceX = (image.width - sourceWidth) / 2;
      const sourceY = (image.height - sourceHeight) / 2;
      ctx.drawImage(image, sourceX, sourceY, sourceWidth, sourceHeight, x, y, width, height);
    }

    function drawSocialIcon(ctx, platform, centerX, centerY, size) {
      const radius = size / 2;
      const colors = {
        facebook: '#1877F2',
        x: '#111111',
        threads: '#111111',
        instagram: '#D62976',
        youtube: '#FF0033',
        linkedin: '#0A66C2'
      };

      ctx.save();
      ctx.translate(centerX, centerY);
      ctx.beginPath();
      ctx.arc(0, 0, radius, 0, Math.PI * 2);
      ctx.fillStyle = colors[platform];
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 3.5;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      if (platform === 'facebook') {
        ctx.font = 'bold 42px Arial, sans-serif';
        ctx.fillText('f', 1, 2);
      } else if (platform === 'x') {
        ctx.beginPath();
        ctx.moveTo(-11, -11);
        ctx.lineTo(11, 11);
        ctx.moveTo(11, -11);
        ctx.lineTo(-11, 11);
        ctx.stroke();
      } else if (platform === 'threads') {
        ctx.font = 'bold 31px Arial, sans-serif';
        ctx.fillText('@', 0, 0);
      } else if (platform === 'instagram') {
        ctx.beginPath();
        ctx.roundRect(-15, -15, 30, 30, 8);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(0, 0, 7, 0, Math.PI * 2);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(9, -9, 1.8, 0, Math.PI * 2);
        ctx.fill();
      } else if (platform === 'youtube') {
        ctx.beginPath();
        ctx.roundRect(-17, -12, 34, 24, 7);
        ctx.fill();
        ctx.fillStyle = colors.youtube;
        ctx.beginPath();
        ctx.moveTo(-3, -7);
        ctx.lineTo(8, 0);
        ctx.lineTo(-3, 7);
        ctx.closePath();
        ctx.fill();
      } else if (platform === 'linkedin') {
        ctx.font = 'bold 26px Arial, sans-serif';
        ctx.fillText('in', 0, 0);
      }
      ctx.restore();
    }

    function switchTab(tabId) {
      const tabs = ['overview', 'photocard', 'texttrigger', 'admanager', 'schedule', 'staff', 'integrations', 'logs'];
      tabs.forEach(t => {
        document.getElementById('tab-' + t).classList.add('hidden');
        document.getElementById('nav-' + t)?.classList.remove('active-nav');
      });
      document.getElementById('tab-' + tabId).classList.remove('hidden');
      document.getElementById('nav-' + tabId)?.classList.add('active-nav');
    }

    function resetTopHeaderColor() {
      document.getElementById('picker-top-bg').value = '#ffffff';
      document.getElementById('picker-top-text').value = '#111111';
      drawCanvas();
    }

    function resetBottomAreaColor() {
      document.getElementById('picker-bottom-bg').value = '#840b0b';
      document.getElementById('picker-bottom-text').value = '#ffffff';
      drawCanvas();
    }

    function handleAutoDateToggle() {
      const isAuto = document.getElementById('toggle-auto-date').checked;
      const dateInput = document.getElementById('input-date-val');
      if(isAuto) {
        const now = new Date();
        const options = { year: 'numeric', month: 'long', day: 'numeric' };
        dateInput.value = now.toLocaleDateString('bn-BD', options);
        dateInput.disabled = true;
      } else {
        dateInput.disabled = false;
      }
      drawCanvas();
    }

    function handleBgUpload(e) {
      const file = e.target.files[0];
      if(file) {
        if (!file.type.startsWith('image/')) {
          showToast('একটি বৈধ ছবি ফাইল নির্বাচন করুন।', 'error');
          e.target.value = '';
          return;
        }
        if (file.size > 10 * 1024 * 1024) {
          showToast('ফিচার ছবিটি ১০ MB-এর চেয়ে বড়। ছোট ছবি ব্যবহার করুন।', 'error');
          e.target.value = '';
          return;
        }
        const reader = new FileReader();
        reader.onerror = () => showToast('ছবিটি পড়া যায়নি। আবার চেষ্টা করুন।', 'error');
        reader.onload = function(event) {
          bgImageObj = new Image();
          bgImageObj.onload = function() { drawCanvas(); }
          bgImageObj.onerror = function() { bgImageObj = null; showToast('ছবিটি খোলা যায়নি।', 'error'); }
          bgImageObj.src = event.target.result;
        }
        reader.readAsDataURL(file);
      }
    }

    function initAdDropdown() {
      const select = document.getElementById('ad-banner-select');
      if(!select) return;
      select.innerHTML = '';
      adBanners.forEach((ad, idx) => {
        const opt = document.createElement('option');
        opt.value = idx;
        opt.textContent = ad.name + ' (' + ad.desc.substring(0, 25) + '...)';
        select.appendChild(opt);
      });
    }

    function changeSelectedAd(val) {
      const index = Number.parseInt(val, 10);
      if (!Number.isInteger(index) || index < 0 || index >= adBanners.length) return;
      currentAdIndex = index;
      document.getElementById('topbar-ad-name').textContent = adBanners[currentAdIndex].name;
      drawCanvas();
    }

    function rotateToNextAd() {
      if (!adBanners.length) {
        showToast('ঘোরানোর জন্য কোনো বিজ্ঞাপন নেই।', 'error');
        return;
      }
      currentAdIndex = (currentAdIndex + 1) % adBanners.length;
      const select = document.getElementById('ad-banner-select');
      if(select) select.value = currentAdIndex;
      document.getElementById('topbar-ad-name').textContent = adBanners[currentAdIndex].name;
      drawCanvas();
      showToast('পরবর্তী বিজ্ঞাপনের ব্যানার লোড করা হয়েছে: ' + adBanners[currentAdIndex].name);
    }

    function renderAdList() {
      const container = document.getElementById('ad-list-container');
      if(!container) return;
      container.replaceChildren();
      adBanners.forEach((ad, idx) => {
        const card = document.createElement('div');
        card.className = 'bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-2';

        const imageWrap = document.createElement('div');
        imageWrap.className = 'aspect-video w-full rounded overflow-hidden relative bg-slate-900';
        const image = document.createElement('img');
        image.src = ad.image;
        image.alt = ad.name;
        image.className = 'w-full h-full object-cover';
        const badge = document.createElement('span');
        badge.className = 'absolute top-1 left-1 bg-amber-600 text-white text-[9px] px-2 py-0.5 rounded font-bold';
        badge.textContent = `এই ব্রাউজারে #${idx + 1}`;
        imageWrap.append(image, badge);

        const name = document.createElement('h4');
        name.className = 'font-semibold text-xs text-slate-200 truncate';
        name.textContent = ad.name;
        const description = document.createElement('p');
        description.className = 'text-[10px] text-slate-400 truncate';
        description.textContent = ad.desc;

        const actions = document.createElement('div');
        actions.className = 'flex gap-2 pt-1';
        const selectButton = document.createElement('button');
        selectButton.className = 'flex-1 text-[11px] bg-slate-800 hover:bg-slate-700 text-amber-300 py-1 rounded transition text-center';
        selectButton.innerHTML = '<i class="fa-solid fa-bolt" aria-hidden="true"></i> সিলেক্ট করুন';
        selectButton.onclick = () => {
          changeSelectedAd(String(idx));
          switchTab('photocard');
        };
        const deleteButton = document.createElement('button');
        deleteButton.className = 'px-2.5 bg-red-600/20 hover:bg-red-600/30 text-red-400 py-1 rounded text-[11px]';
        deleteButton.setAttribute('aria-label', `${ad.name} মুছুন`);
        deleteButton.innerHTML = '<i class="fa-solid fa-trash" aria-hidden="true"></i>';
        deleteButton.onclick = () => deleteAd(idx);
        actions.append(selectButton, deleteButton);
        card.append(imageWrap, name, description, actions);
        container.appendChild(card);
      });
      document.getElementById('overview-active-ads').textContent = adBanners.length + ' টি';
    }

    function uploadAdFromPC() {
      const name = document.getElementById('new-ad-name').value;
      const desc = document.getElementById('new-ad-desc').value;
      const fileInput = document.getElementById('new-ad-file');

      if(!name.trim()) { showToast('দয়া করে বিজ্ঞাপনের নাম লিখুন।', 'error'); return; }
      if(!fileInput.files || !fileInput.files[0]) { showToast('দয়া করে ব্যানার ছবি সিলেক্ট করুন।', 'error'); return; }

      const file = fileInput.files[0];
      if (!file.type.startsWith('image/')) {
        showToast('একটি বৈধ ছবি ফাইল নির্বাচন করুন।', 'error');
        return;
      }
      if (file.size > MAX_AD_IMAGE_BYTES) {
        showToast('ছবিটি ২ MB-এর চেয়ে বড়। ছোট ছবি ব্যবহার করুন।', 'error');
        return;
      }
      const reader = new FileReader();
      reader.onerror = () => showToast('ছবিটি পড়া যায়নি। আবার চেষ্টা করুন।', 'error');
      reader.onload = function(event) {
        let img = new Image();
        img.onload = function() {
          const newAd = {
            id: 'ad-' + Date.now(),
            name: name.trim(),
            desc: desc.trim() || 'বিশেষ অফার',
            image: event.target.result
          };
          adBanners.push(newAd);
          if (!saveAdBanners()) {
            adBanners.pop();
            return;
          }
          const newIdx = adBanners.length - 1;
          adImageObjs[newIdx] = img;
          currentAdIndex = newIdx;
          initAdDropdown();
          renderAdList();
          document.getElementById('ad-banner-select').value = currentAdIndex;
          drawCanvas();
          document.getElementById('new-ad-name').value = '';
          document.getElementById('new-ad-desc').value = '';
          fileInput.value = '';
          showToast('ব্যানার এই ব্রাউজারে সংরক্ষণ করা হয়েছে।');
        };
        img.onerror = () => showToast('ছবিটি খোলা যায়নি। অন্য ছবি ব্যবহার করুন।', 'error');
        img.src = event.target.result;
      }
      reader.readAsDataURL(file);
    }

    function deleteAd(idx) {
      if(adBanners.length <= 1) { alert('অন্তত একটি বিজ্ঞাপন থাকা আবশ্যক!'); return; }
      if(confirm('আপনি কি নিশ্চিত এই বিজ্ঞাপনটি ডিলিট করতে চান?')) {
        const selectedId = adBanners[currentAdIndex]?.id;
        const [removedAd] = adBanners.splice(idx, 1);
        if (!saveAdBanners()) {
          adBanners.splice(idx, 0, removedAd);
          return;
        }
        const selectedIndex = adBanners.findIndex(ad => ad.id === selectedId);
        currentAdIndex = selectedIndex >= 0 ? selectedIndex : Math.min(idx, adBanners.length - 1);
        initAdDropdown();
        document.getElementById('ad-banner-select').value = currentAdIndex;
        renderAdList();
        preloadAdImages();
        document.getElementById('topbar-ad-name').textContent = adBanners[currentAdIndex].name;
        drawCanvas();
        showToast('বিজ্ঞাপনটি এই ব্রাউজার থেকে মুছে ফেলা হয়েছে।');
      }
    }

    // ==================== 1920x1920 CANVAS DRAWING ENGINE ====================
    function drawCanvas() {
      const canvas = document.getElementById('photocardCanvas');
      if(!canvas) return;
      const ctx = canvas.getContext('2d');
      const width = 1920;
      const height = 1920;

      ctx.clearRect(0, 0, width, height);

      // 1. TOP HEADER BORDER (0px to 80px)
      const topBgColor = document.getElementById('picker-top-bg').value;
      const topTextColor = document.getElementById('picker-top-text').value;

      ctx.fillStyle = topBgColor;
      ctx.fillRect(0, 0, width, 80);

      ctx.fillStyle = '#df202c';
      ctx.font = '900 48px "Hind Siliguri", sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('ডিএন', 60, 58);
      ctx.fillStyle = '#16763d';
      ctx.fillText('বাংলা', 175, 58);

      ctx.fillStyle = topTextColor;
      ctx.font = '600 38px "Hind Siliguri", sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText(document.getElementById('input-date-val').value, width - 60, 55);

      // 2. FEATURE PHOTO AREA (From 80px to 1165px — এখন ১০৯০px থেকে ১১৬৫px অংশটিও ফিচার ছবির অন্তর্ভুক্ত করা হলো)
      const photoY = 80;
      const photoH = 1085; // 80px থেকে 1165px পর্যন্ত ফিচার ছবি বিস্তৃত থাকবে 
      if (bgImageObj) {
        drawImageCover(ctx, bgImageObj, 0, photoY, width, photoH);
      } else {
        let grad = ctx.createLinearGradient(0, photoY, 0, photoY + photoH);
        grad.addColorStop(0, '#334155');
        grad.addColorStop(1, '#0f172a');
        ctx.fillStyle = grad;
        ctx.fillRect(0, photoY, width, photoH);

        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 50px "Hind Siliguri", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('সংবাদের ফিচার ছবি (1920x1080px)', width / 2, photoY + (photoH / 2));
      }

      if(document.getElementById('toggle-category-badge').checked) {
        const catText = document.getElementById('input-category').value;
        if(catText.trim() !== "") {
          ctx.font = 'bold 36px "Hind Siliguri", sans-serif';
          const badgeWidth = Math.min(width - 120, ctx.measureText(catText).width + 80);
          ctx.fillStyle = '#e50914';
          ctx.fillRect(60, photoY + 50, badgeWidth, 70);
          ctx.fillStyle = '#ffffff';
          ctx.textAlign = 'left';
          ctx.fillText(catText, 100, photoY + 100, Math.max(0, badgeWidth - 80));
        }
      }

      // "বিস্তারিত কমেন্টে" ROUNDED BADGE (1090px to 1165px = 75px Area) -> ছবির ওপর ওভারলে হিসেবে থাকবে (কোনো সাদা ব্যাকগ্রাউন্ড ছাড়া)
      if(document.getElementById('toggle-comment-badge').checked) {
        const commentText = document.getElementById('input-comment-text').value;
        ctx.font = 'bold 32px "Hind Siliguri", sans-serif';
        const textWidth = ctx.measureText(commentText).width;
        
        const badgeHeight = 55; 
        const badgeWidth = textWidth + 70;
        
        const badgeX = (width - badgeWidth) / 2;
        const badgeY = 1090 + (75 - badgeHeight) / 2; 
        const cornerRadius = badgeHeight / 2; 

        // Draw Rounded Rectangle Base
        ctx.beginPath();
        ctx.fillStyle = '#059669';
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 4;
        
        ctx.moveTo(badgeX + cornerRadius, badgeY);
        ctx.lineTo(badgeX + badgeWidth - cornerRadius, badgeY);
        ctx.quadraticCurveTo(badgeX + badgeWidth, badgeY, badgeX + badgeWidth, badgeY + cornerRadius);
        ctx.lineTo(badgeX + badgeWidth, badgeY + badgeHeight - cornerRadius);
        ctx.quadraticCurveTo(badgeX + badgeWidth, badgeY + badgeHeight, badgeX + badgeWidth - cornerRadius, badgeY + badgeHeight);
        ctx.lineTo(badgeX + cornerRadius, badgeY + badgeHeight);
        ctx.quadraticCurveTo(badgeX, badgeY + badgeHeight, badgeX, badgeY + badgeHeight - cornerRadius);
        ctx.lineTo(badgeX, badgeY + cornerRadius);
        ctx.quadraticCurveTo(badgeX, badgeY, badgeX + cornerRadius, badgeY);
        ctx.closePath();
        
        ctx.fill();
        ctx.stroke();

        // Draw Badge Text
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'center';
        ctx.fillText(commentText, width / 2, badgeY + 38);
      }

      // 3. HEADLINE AREA (1165px - 1563px = 398px Scope Area) -> Auto 1/2/3 Lines Alignment
      const headlineYStart = 1165;
      const headlineYEnd = 1563;
      const headlineH = headlineYEnd - headlineYStart; // 398px

      const bottomBgColor = document.getElementById('picker-bottom-bg').value;
      const headlineTextColor = document.getElementById('picker-bottom-text').value;

      ctx.fillStyle = bottomBgColor;
      ctx.fillRect(0, headlineYStart, width, headlineH);

      ctx.save();
      ctx.beginPath();
      ctx.rect(0, headlineYStart, width, headlineH);
      ctx.clip();

      const headline = document.getElementById('input-headline').value;
      let fontSize = parseInt(document.getElementById('input-fontsize').value);
      const sideMargin = parseInt(document.getElementById('input-margin').value);
      const maxWidth = width - (sideMargin * 2);

      ctx.fillStyle = headlineTextColor;
      ctx.textAlign = 'center';
      ctx.font = `bold ${fontSize}px "Hind Siliguri", sans-serif`;

      let lines = wrapText(ctx, headline, maxWidth);
      
      while ((lines.length * (fontSize * 1.35)) > (headlineH - 20) && fontSize > 18) {
        fontSize -= 2;
        ctx.font = `bold ${fontSize}px "Hind Siliguri", sans-serif`;
        lines = wrapText(ctx, headline, maxWidth);
      }

      const lineGap = fontSize * 1.35;
      const totalTextHeight = lines.length * lineGap;
      let startY = headlineYStart + (headlineH - totalTextHeight) / 2 + (fontSize * 0.85);

      lines.forEach((line, index) => {
        ctx.fillText(line, width / 2, startY + (index * lineGap));
      });
      ctx.restore();

      document.getElementById('fontsize-val').textContent = fontSize + 'px';
      document.getElementById('margin-val').textContent = sideMargin + 'px';

      // 4. SOCIAL & WEBSITE LINK BAR (1563px to 1640px)
      const socialBarY = 1563;
      const socialBarH = 77;

      if(document.getElementById('toggle-social-bar').checked) {
        const footerBgColor = document.getElementById('input-footer-bg').value;
        ctx.fillStyle = footerBgColor;
        ctx.fillRect(0, socialBarY, width, socialBarH);
        ctx.strokeStyle = '#334155';
        ctx.lineWidth = 2;
        ctx.strokeRect(0, socialBarY, width, socialBarH);

        const websiteUrl = document.getElementById('link-website').value.trim();
        if (websiteUrl) {
          ctx.fillStyle = '#f8fafc';
          ctx.font = '600 30px "Hind Siliguri", sans-serif';
          ctx.textAlign = 'left';
          ctx.textBaseline = 'middle';
          ctx.fillText(websiteUrl, 64, socialBarY + socialBarH / 2, 500);
        }

        const socials = [
          { platform: 'facebook', url: document.getElementById('link-facebook').value.trim() },
          { platform: 'x', url: document.getElementById('link-x').value.trim() },
          { platform: 'threads', url: document.getElementById('link-threads').value.trim() },
          { platform: 'instagram', url: document.getElementById('link-instagram').value.trim() },
          { platform: 'youtube', url: document.getElementById('link-youtube').value.trim() },
          { platform: 'linkedin', url: document.getElementById('link-linkedin').value.trim() }
        ].filter(social => social.url);

        const iconSize = 52;
        const iconGap = 42;
        const groupWidth = socials.length * iconSize + Math.max(0, socials.length - 1) * iconGap;
        const iconAreaStart = websiteUrl ? 610 : 0;
        const iconAreaEnd = width - (websiteUrl ? 55 : 0);
        const iconAreaWidth = iconAreaEnd - iconAreaStart;
        const firstIconX = iconAreaStart + (iconAreaWidth - groupWidth) / 2 + iconSize / 2;
        socials.forEach((social, index) => {
          drawSocialIcon(
            ctx,
            social.platform,
            firstIconX + index * (iconSize + iconGap),
            socialBarY + socialBarH / 2,
            iconSize
          );
        });
      }

      // ADVERTISEMENT BANNER AREA (1640px to 1920px)
      const adY = 1640;
      const adH = 280;
      const adImg = adImageObjs[currentAdIndex];

      if (adImg && adImg.complete) {
        drawImageCover(ctx, adImg, 0, adY, width, adH);
      } else {
        ctx.fillStyle = '#800000';
        ctx.fillRect(0, adY, width, adH);
      }
    }

    function wrapText(ctx, text, maxWidth) {
      const safeWidth = Math.max(1, maxWidth);
      const paragraphs = String(text ?? '').replace(/\r/g, '').split('\n');
      const lines = [];
      const segmenter = typeof Intl !== 'undefined' && Intl.Segmenter
        ? new Intl.Segmenter('bn', { granularity: 'grapheme' })
        : null;

      paragraphs.forEach(paragraph => {
        const words = paragraph.trim().split(/\s+/).filter(Boolean);
        if (!words.length) {
          lines.push('');
          return;
        }

        let currentLine = '';
        words.forEach(word => {
          const candidate = currentLine ? `${currentLine} ${word}` : word;
          if (ctx.measureText(candidate).width <= safeWidth) {
            currentLine = candidate;
            return;
          }

          if (currentLine) lines.push(currentLine);
          if (ctx.measureText(word).width <= safeWidth) {
            currentLine = word;
            return;
          }

          const graphemes = segmenter
            ? Array.from(segmenter.segment(word), item => item.segment)
            : Array.from(word);
          let chunk = '';
          graphemes.forEach(grapheme => {
            if (chunk && ctx.measureText(chunk + grapheme).width > safeWidth) {
              lines.push(chunk);
              chunk = grapheme;
            } else {
              chunk += grapheme;
            }
          });
          currentLine = chunk;
        });
        lines.push(currentLine);
      });

      return lines.length ? lines : [''];
    }

    function downloadCanvas() {
      downloadCanvasPng(
        document.getElementById('photocardCanvas'),
        'DN-Bangla-1920x1920-Photocard.png',
        '১৯২০x১৯২০ পিক্সেল ফটোকার্ড ডাউনলোড হয়েছে।'
      );
    }

    function downloadCanvasPng(canvas, filename, successMessage) {
      if (!canvas) {
        showToast('ডাউনলোডের জন্য ক্যানভাস পাওয়া যায়নি।', 'error');
        return;
      }
      try {
        canvas.toBlob(blob => {
          if (!blob) {
            showToast('ছবি তৈরি করা যায়নি। আবার চেষ্টা করুন।', 'error');
            return;
          }
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.download = filename;
          link.href = url;
          link.click();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
          showToast(successMessage);
        }, 'image/png');
      } catch (error) {
        console.error('Canvas export failed.', error);
        showToast('ডাউনলোড ব্যর্থ। কোনো অনিরাপদ বা CORS-সীমাবদ্ধ ছবি থাকলে সেটি সরিয়ে আবার চেষ্টা করুন।', 'error');
      }
    }

    // ==================== TEXT / TRIGGER PHOTOCARD ====================
    function updateTextTriggerColorControls() {
      const isCustom = document.getElementById('text-trigger-bg').value === 'custom';
      const colorInput = document.getElementById('text-trigger-custom-color');
      const hint = document.getElementById('text-trigger-custom-hint');
      colorInput.disabled = !isCustom;
      colorInput.classList.toggle('cursor-not-allowed', !isCustom);
      colorInput.classList.toggle('cursor-pointer', isCustom);
      colorInput.classList.toggle('opacity-50', !isCustom);
      hint.textContent = isCustom
        ? 'রং পরিবর্তন করলে প্রিভিউ সঙ্গে সঙ্গে আপডেট হবে।'
        : 'কাস্টম কালার ব্যবহার করতে “Custom Color” বেছে নিন।';
    }

    function handleTextTriggerBackgroundChange() {
      updateTextTriggerColorControls();
      drawTextTriggerCanvas();
    }

    function darkenTextTriggerColor(hexColor, factor = 0.48) {
      const normalized = String(hexColor).replace('#', '');
      if (!/^[0-9a-f]{6}$/i.test(normalized)) return '#0b0f19';
      const channels = [0, 2, 4].map(offset =>
        Math.round(parseInt(normalized.slice(offset, offset + 2), 16) * factor)
      );
      return '#' + channels.map(channel => channel.toString(16).padStart(2, '0')).join('');
    }

    function drawTextTriggerCanvas() {
      const canvas = document.getElementById('textTriggerCanvas');
      if(!canvas) return;
      const ctx = canvas.getContext('2d');
      const width = canvas.width;
      const height = canvas.height;
      const headerHeight = 85;
      const socialBarY = 1563;
      const socialBarH = 77;
      const adY = 1640;
      const adH = 280;

      ctx.clearRect(0, 0, width, height);

      const backgroundStyle = document.getElementById('text-trigger-bg').value;
      const backgroundPalettes = {
        'gradient-red': ['#b20710', '#0f172a'],
        'gradient-blue': ['#334155', '#0b1224'],
        'gradient-maroon': ['#840b0b', '#241018'],
        'gradient-dark': ['#111827', '#030712']
      };
      const customColor = document.getElementById('text-trigger-custom-color').value;
      const palette = backgroundStyle === 'custom'
        ? [customColor, darkenTextTriggerColor(customColor)]
        : backgroundPalettes[backgroundStyle] || backgroundPalettes['gradient-red'];
      let grad = ctx.createLinearGradient(0, 0, width, height);
      grad.addColorStop(0, palette[0]);
      grad.addColorStop(1, palette[1]);
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, width, height);

      // Header: match the main photo-card's branding and use today's Dhaka date.
      ctx.fillStyle = document.getElementById('picker-top-bg').value;
      ctx.fillRect(0, 0, width, headerHeight);
      ctx.fillStyle = '#df202c';
      ctx.font = '900 48px "Hind Siliguri", sans-serif';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText('ডিএন', 60, 58);
      ctx.fillStyle = '#16763d';
      ctx.fillText('বাংলা', 175, 58);
      ctx.fillStyle = document.getElementById('picker-top-text').value;
      ctx.font = '600 38px "Hind Siliguri", sans-serif';
      ctx.textAlign = 'right';
      const today = new Date().toLocaleDateString('bn-BD', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'Asia/Dhaka'
      });
      ctx.fillText(today, width - 60, 55, 700);

      // Keep the existing small category treatment and placement unchanged.
      ctx.fillStyle = 'rgba(255, 255, 255, 0.15)';
      ctx.fillRect(100, 240, width - 200, 90);
      const cat = document.getElementById('text-trigger-cat').value;
      ctx.fillStyle = '#f59e0b';
      ctx.font = 'bold 42px "Hind Siliguri", sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(cat, width / 2, 300, width - 360);

      const content = document.getElementById('text-trigger-content').value;
      const requestedFontSize = parseInt(document.getElementById('tc-input-fontsize').value, 10) || 75;
      const sideMargin = parseInt(document.getElementById('tc-input-margin').value, 10) || 225;
      const maxWidth = Math.max(1, width - (sideMargin * 2));
      const textAreaBottom = socialBarY;
      let tcFontSize = requestedFontSize;
      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      function layoutMessage(areaTop) {
        const areaHeight = textAreaBottom - areaTop;
        tcFontSize = requestedFontSize;
        ctx.font = `bold ${tcFontSize}px "Hind Siliguri", sans-serif`;
        let lines = wrapText(ctx, content, maxWidth);
        while (lines.length * tcFontSize * 1.3 > areaHeight && tcFontSize > 18) {
          tcFontSize = Math.max(18, tcFontSize - 2);
          ctx.font = `bold ${tcFontSize}px "Hind Siliguri", sans-serif`;
          lines = wrapText(ctx, content, maxWidth);
        }
        const lineHeight = Math.min(tcFontSize * 1.3, areaHeight / Math.max(1, lines.length));
        const totalHeight = lines.length * lineHeight;
        return {
          areaTop,
          areaHeight,
          lines,
          lineHeight,
          totalHeight,
          firstBaseline: areaTop + (areaHeight - totalHeight) / 2 + tcFontSize * 0.85
        };
      }
      let layout = layoutMessage(headerHeight);
      const visibleTextTop = layout.firstBaseline - tcFontSize * 0.85;
      const visibleTextBottom = layout.firstBaseline + (layout.lines.length - 1) * layout.lineHeight;
      if (visibleTextTop < 350 && visibleTextBottom > 220) {
        layout = layoutMessage(350);
      }

      ctx.save();
      ctx.beginPath();
      ctx.rect(sideMargin, layout.areaTop, maxWidth, layout.areaHeight);
      ctx.clip();
      layout.lines.forEach((line, index) => {
        ctx.fillText(line, width / 2, layout.firstBaseline + (index * layout.lineHeight), maxWidth);
      });
      ctx.restore();

      document.getElementById('tc-fontsize-val').textContent = tcFontSize + 'px';
      document.getElementById('tc-margin-val').textContent = `${sideMargin}px / ${maxWidth}px`;

      // Social/site strip: mirror the main photo-card section (1563–1640px).
      ctx.fillStyle = document.getElementById('input-footer-bg').value;
      ctx.fillRect(0, socialBarY, width, socialBarH);
      ctx.strokeStyle = '#334155';
      ctx.lineWidth = 2;
      ctx.strokeRect(0, socialBarY, width, socialBarH);
      const websiteUrl = document.getElementById('link-website').value.trim();
      if (websiteUrl) {
        ctx.fillStyle = '#f8fafc';
        ctx.font = '600 30px "Hind Siliguri", sans-serif';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        ctx.fillText(websiteUrl, 64, socialBarY + socialBarH / 2, 500);
      }
      const socials = [
        { platform: 'facebook', url: document.getElementById('link-facebook').value.trim() },
        { platform: 'x', url: document.getElementById('link-x').value.trim() },
        { platform: 'threads', url: document.getElementById('link-threads').value.trim() },
        { platform: 'instagram', url: document.getElementById('link-instagram').value.trim() },
        { platform: 'youtube', url: document.getElementById('link-youtube').value.trim() },
        { platform: 'linkedin', url: document.getElementById('link-linkedin').value.trim() }
      ].filter(social => social.url);
      const iconSize = 52;
      const iconGap = 42;
      const groupWidth = socials.length * iconSize + Math.max(0, socials.length - 1) * iconGap;
      const iconAreaStart = websiteUrl ? 610 : 0;
      const iconAreaEnd = width - (websiteUrl ? 55 : 0);
      const iconAreaWidth = iconAreaEnd - iconAreaStart;
      const firstIconX = iconAreaStart + (iconAreaWidth - groupWidth) / 2 + iconSize / 2;
      socials.forEach((social, index) => {
        drawSocialIcon(
          ctx,
          social.platform,
          firstIconX + index * (iconSize + iconGap),
          socialBarY + socialBarH / 2,
          iconSize
        );
      });

      // Advertisement strip: use the shared ad list, but rotate independently
      // from the main photo-card page.
      const safeTextAdIndex = adBanners.length ? textAdIndex % adBanners.length : -1;
      const adImg = safeTextAdIndex >= 0 ? adImageObjs[safeTextAdIndex] : null;
      if (adImg && adImg.complete) {
        drawImageCover(ctx, adImg, 0, adY, width, adH);
      } else {
        ctx.fillStyle = '#800000';
        ctx.fillRect(0, adY, width, adH);
      }
    }

    function generateTextTriggerCard() {
      if (adBanners.length) {
        textAdIndex = (textAdIndex + 1) % adBanners.length;
      }
      drawTextTriggerCanvas();
      const adName = adBanners[textAdIndex]?.name;
      showToast(adName
        ? `নতুন টেক্সট ফটোকার্ড তৈরি হয়েছে। বিজ্ঞাপন: ${adName}`
        : 'নতুন টেক্সট ফটোকার্ড তৈরি হয়েছে।');
    }

    function downloadTextTriggerCanvas() {
      downloadCanvasPng(
        document.getElementById('textTriggerCanvas'),
        'DN-Bangla-Text-Photocard-1920x1920.png',
        'টেক্সট ফটোকার্ড ডাউনলোড হয়েছে।'
      );
    }

    function publishDirectly(platform) {
      showToast(`${platform}-এ পোস্ট করা হয়নি—এই ফাইলে কোনো প্রকাশ API সংযুক্ত নেই।`, 'info');
      switchTab('integrations');
    }

    function triggerAutoFetch() {
      showToast('WordPress সিঙ্ক করা হয়নি—API সংযোগ এখনো সেটআপ করা নেই।', 'info');
      switchTab('integrations');
    }

    function showUnavailable(feature) {
      showToast(`${feature} চালু নেই—এই ফাইলে কোনো সার্ভার বা শিডিউলার সংযুক্ত নেই।`, 'info');
    }

    function showToast(msg, type = 'success') {
      const toast = document.getElementById('toast-message');
      const toastText = document.getElementById('toast-text');
      const styles = {
        success: { classes: 'bg-emerald-500/20 border-emerald-500/40 text-emerald-300', icon: 'fa-circle-check' },
        info: { classes: 'bg-sky-500/20 border-sky-500/40 text-sky-200', icon: 'fa-circle-info' },
        error: { classes: 'bg-red-500/20 border-red-500/40 text-red-200', icon: 'fa-circle-exclamation' }
      };
      const style = styles[type] || styles.success;
      toast.className = `p-3 rounded-lg border text-xs flex items-center justify-between transition-all ${style.classes}`;
      toastText.replaceChildren();
      const icon = document.createElement('i');
      icon.className = `fa-solid ${style.icon} mr-2`;
      icon.setAttribute('aria-hidden', 'true');
      toastText.append(icon, document.createTextNode(msg));
      toast.classList.remove('hidden');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('hidden');
      }, 4000);
    }

    function clearLogs() {
      document.getElementById('system-logs-box').innerHTML = `<p>[${new Date().toLocaleTimeString()}] Logs cleared.</p>`;
    }
  </script>
