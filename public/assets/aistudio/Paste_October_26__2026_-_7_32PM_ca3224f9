      background-color: #e50914 !important;
      color: #ffffff !important;
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col md:flex-row antialiased selection:bg-red-600 selection:text-white">

  <!-- Sidebar Navigation -->
  <aside class="w-full md:w-64 bg-slate-900 border-b md:border-b-0 md:border-r border-slate-800 flex-shrink-0">
    <div class="p-4 border-b border-slate-800 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="bg-red-600 text-white font-bold rounded-lg px-2.5 py-1 text-lg shadow-lg shadow-red-900/40">DN</div>
        <div>
          <h1 class="font-bold text-base tracking-wide text-white">ডিএন বাংলা</h1>
          <p class="text-[10px] text-slate-400">1920x1920 PhotoCard Engine</p>
        </div>
      </div>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] bg-amber-500/10 text-amber-300 border border-amber-500/20 rounded-full font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> লোকাল ডেমো
      </span>
    </div>

    <nav class="p-3 space-y-1 text-sm font-medium">
      <button onclick="switchTab('overview')" id="nav-overview" class="active-nav w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition text-slate-300 hover:bg-slate-800 text-left">
        <i class="fa-solid fa-chart-pie w-5 text-center"></i> ওভারভিউ ড্যাশবোর্ড
      </button>
      <button onclick="switchTab('photocard')" id="nav-photocard" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition text-slate-300 hover:bg-slate-800 text-left">
        <i class="fa-solid fa-image w-5 text-center"></i> ফটোকার্ড জেনারেটর (1920x1920)
      </button>
      <button onclick="switchTab('texttrigger')" id="nav-texttrigger" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition text-slate-300 hover:bg-slate-800 text-left">
        <i class="fa-solid fa-font w-5 text-center"></i> টেক্সট / টিগার ফটোকার্ড
      </button>
      <button onclick="switchTab('admanager')" id="nav-admanager" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition text-slate-300 hover:bg-slate-800 text-left">
        <i class="fa-solid fa-arrows-spin w-5 text-center"></i> লোকাল এড ম্যানেজার ও রোটেটর
      </button>
      <button onclick="switchTab('schedule')" id="nav-schedule" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition text-slate-300 hover:bg-slate-800 text-left">
        <i class="fa-solid fa-clock-rotate-left w-5 text-center"></i> দৈনিক অটো শিডিউলার
      </button>
      <button onclick="switchTab('staff')" id="nav-staff" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition text-slate-300 hover:bg-slate-800 text-left">
        <i class="fa-solid fa-id-card w-5 text-center"></i> কর্মী আইডি কার্ড জেনারেটর
      </button>
      <button onclick="switchTab('integrations')" id="nav-integrations" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition text-slate-300 hover:bg-slate-800 text-left">
        <i class="fa-brands fa-wordpress w-5 text-center"></i> ওয়ার্ডপ্রেস ও সোশ্যাল API
      </button>
      <button onclick="switchTab('logs')" id="nav-logs" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition text-slate-300 hover:bg-slate-800 text-left">
        <i class="fa-solid fa-terminal w-5 text-center"></i> লাইভ সিস্টেম লগস
      </button>
    </nav>
  </aside>

  <!-- Main Content Area -->
  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <!-- Top Bar -->
    <header class="bg-slate-900 border-b border-slate-800 p-4 flex justify-between items-center sticky top-0 z-20 shadow-md">
      <div>
        <h2 id="page-title" class="text-lg font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-gauge-high text-red-500"></i> অটোমেশন কন্ট্রোল সেন্টার
        </h2>
      </div>
      <div class="flex items-center gap-3">
        <div class="text-xs bg-slate-800 text-slate-300 px-3 py-1.5 rounded-lg border border-slate-700 hidden sm:flex items-center gap-2">
          <i class="fa-solid fa-rotate text-emerald-400 animate-spin"></i>
          <span>সক্রিয় বিজ্ঞাপন: <strong id="topbar-ad-name" class="text-amber-400">নিউ ক্লাসিক ইভেন্ট</strong></span>
        </div>
        <button onclick="triggerAutoFetch()" class="bg-red-600 hover:bg-red-700 text-white px-3.5 py-1.5 rounded-lg text-xs font-semibold shadow flex items-center gap-2 transition">
          <i class="fa-brands fa-wordpress" id="sync-icon"></i> ওয়ার্ডপ্রেস সংযোগ
        </button>
      </div>
    </header>

    <div class="p-4 md:p-6 space-y-6">

      <!-- Alert Notification Banner -->
      <div id="toast-message" class="hidden p-3 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-xs flex items-center justify-between transition-all">
        <span id="toast-text"><i class="fa-solid fa-check-circle mr-2"></i> সফলভাবে সম্পন্ন হয়েছে!</span>
        <button onclick="document.getElementById('toast-message').classList.add('hidden')" class="text-emerald-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <!-- ==================== TAB 1: OVERVIEW ==================== -->
      <section id="tab-overview" class="space-y-6">
        <div class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-xs text-amber-200">
          <i class="fa-solid fa-circle-info mr-1" aria-hidden="true"></i>
          এই ড্যাশবোর্ডের সংখ্যা নমুনা; এখানে কোনো WordPress, সোশ্যাল মিডিয়া বা শিডিউলার ডেটা সংযুক্ত নেই।
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 flex items-center justify-between">
            <div>
              <p class="text-xs text-slate-400">আজকের অটো ফটোকার্ড</p>
              <h3 class="text-2xl font-bold text-white mt-1">৫৬ টি</h3>
            </div>
            <div class="w-12 h-12 rounded-lg bg-red-500/10 text-red-500 flex items-center justify-center text-xl">
              <i class="fa-solid fa-newspaper"></i>
            </div>
          </div>
          <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 flex items-center justify-between">
            <div>
              <p class="text-xs text-slate-400">ওয়ার্ডপ্রেস সিঙ্ক পোস্ট</p>
              <h3 class="text-2xl font-bold text-white mt-1">৩২ টি</h3>
            </div>
            <div class="w-12 h-12 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center text-xl">
              <i class="fa-brands fa-wordpress"></i>
            </div>
          </div>
          <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 flex items-center justify-between">
            <div>
              <p class="text-xs text-slate-400">লোকাল বিজ্ঞাপন ব্যানার</p>
              <h3 class="text-2xl font-bold text-amber-400 mt-1" id="overview-active-ads">৩ টি</h3>
            </div>
            <div class="w-12 h-12 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center text-xl">
              <i class="fa-solid fa-arrows-spin"></i>
            </div>
          </div>
          <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 flex items-center justify-between">
            <div>
              <p class="text-xs text-slate-400">নিবন্ধিত কর্মী আইডি</p>
              <h3 class="text-2xl font-bold text-emerald-400 mt-1">৩ জন</h3>
            </div>
            <div class="w-12 h-12 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xl">
              <i class="fa-solid fa-address-card"></i>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================== TAB 2: PHOTOCARD GENERATOR (1920x1920) ==================== -->
      <section id="tab-photocard" class="space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

          <!-- Left Controls (5 cols) -->
          <div class="lg:col-span-5 bg-slate-900 rounded-xl border border-slate-800 p-5 space-y-4 max-h-[85vh] overflow-y-auto">
            <h3 class="font-bold text-base text-white border-b border-slate-800 pb-3 flex items-center justify-between">
              <span><i class="fa-solid fa-sliders text-red-500"></i> ফটোকার্ড ডিজাইন কন্ট্রোল</span>
              <span class="text-xs px-2 py-0.5 bg-red-500/20 text-red-400 border border-red-500/30 rounded font-mono">1920x1920 PX</span>
            </h3>

            <!-- ১. টপ হেডার ব্যাকগ্রাউন্ড কালার -->
            <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-2">
              <label class="block text-xs font-bold text-emerald-400">
                <span><i class="fa-solid fa-palette"></i> ১. টপ হেডার ব্যাকগ্রাউন্ড কালার (0px-80px)</span>
              </label>
              <div class="flex items-center gap-2">
                <button onclick="resetTopHeaderColor()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded text-xs text-slate-200">
                  <i class="fa-solid fa-rotate-left mr-1"></i> ডিফল্ট (হোয়াইট)
                </button>
                <div class="flex-1 flex items-center gap-2 bg-slate-900 px-3 py-1 border border-slate-700 rounded">
                  <span class="text-[11px] text-slate-400">কাস্টম:</span>
                  <input type="color" id="picker-top-bg" value="#ffffff" onchange="drawCanvas()" class="w-7 h-6 bg-transparent rounded cursor-pointer">
                  <input type="color" id="picker-top-text" value="#111111" onchange="drawCanvas()" title="তারিখ ফন্ট কালার" class="w-7 h-6 bg-transparent rounded cursor-pointer">
                </div>
              </div>
            </div>

            <!-- ২. ফিচার ছবির নিচের ব্যাকগ্রাউন্ড কালার -->
            <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-2">
              <label class="block text-xs font-bold text-amber-400">
                <span><i class="fa-solid fa-palette"></i> ২. হেডলাইনের ব্যাকগ্রাউন্ড কালার (1165px-1563px)</span>
              </label>
              <div class="flex items-center gap-2">
                <button onclick="resetBottomAreaColor()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded text-xs text-slate-200">
                  <i class="fa-solid fa-rotate-left mr-1"></i> ডিফল্ট (মেরুন)
                </button>
                <div class="flex-1 flex items-center gap-2 bg-slate-900 px-3 py-1 border border-slate-700 rounded">
                  <span class="text-[11px] text-slate-400">কাস্টম:</span>
                  <input type="color" id="picker-bottom-bg" value="#840b0b" onchange="drawCanvas()" class="w-7 h-6 bg-transparent rounded cursor-pointer">
                  <input type="color" id="picker-bottom-text" value="#ffffff" onchange="drawCanvas()" title="হেডলাইন কালার" class="w-7 h-6 bg-transparent rounded cursor-pointer">
                </div>
              </div>
            </div>

            <!-- Inputs & Controls -->
            <div class="space-y-3">
              <!-- ক্যাটাগরি / ট্যাগ কন্ট্রোল -->
              <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-2">
                <div class="flex items-center justify-between">
                  <label class="text-xs font-bold text-slate-200">ক্যাটাগরি / ট্যাগ (ডিএন বাংলা)</label>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="toggle-category-badge" checked onchange="drawCanvas()" class="sr-only peer">
                    <div class="w-8 h-4 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-red-600"></div>
                    <span class="ml-2 text-[10px] text-slate-400 font-medium">চালু / বন্ধ</span>
                  </label>
                </div>
                <input type="text" id="input-category" value="জাতীয় সংবাদ" oninput="drawCanvas()" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-red-500">
              </div>

              <!-- Date Controls -->
              <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-2">
                <div class="flex items-center justify-between">
                  <label class="text-xs font-bold text-slate-200">তারিখ সিস্টেম (ডান পাশে)</label>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="toggle-auto-date" checked onchange="handleAutoDateToggle()" class="sr-only peer">
                    <div class="w-8 h-4 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-red-600"></div>
                    <span class="ml-2 text-[10px] text-slate-400 font-medium">অটো তারিখ</span>
                  </label>
                </div>
                <input type="text" id="input-date-val" oninput="drawCanvas()" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-1.5 text-xs text-slate-200">
              </div>

              <!-- "বিস্তারিত কমেন্টে" রাউন্ড ব্যাজ (১০৯০px - ১১৬৫px = ৭৫px) -->
              <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-2">
                <div class="flex items-center justify-between">
                  <label class="text-xs font-bold text-emerald-400 flex items-center gap-1">
                    <i class="fa-solid fa-circle-dot"></i> "বিস্তারিত কমেন্টে" রাউন্ড ব্যাজ (1090px - 1165px)
                  </label>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="toggle-comment-badge" checked onchange="drawCanvas()" class="sr-only peer">
                    <div class="w-8 h-4 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-emerald-600"></div>
                    <span class="ml-2 text-[10px] text-slate-400 font-medium">চালু / বন্ধ</span>
                  </label>
                </div>
                <input type="text" id="input-comment-text" value="বিস্তারিত কমেন্টে" oninput="drawCanvas()" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-1.5 text-xs text-slate-200">
              </div>

              <!-- শিরোনাম / মূল হেডিং (১১৬৫px - ১৫৬৩px = ৩৯৮px) -->
              <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-2">
                <label class="block text-xs font-bold text-red-400 mb-1">
                  <i class="fa-solid fa-heading mr-1"></i> শিরোনাম / মূল হেডিং (১১৬৫px - ১৫৬৩px = ৩৯৮px):
                </label>
                <textarea id="input-headline" rows="3" oninput="drawCanvas()" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2 text-sm text-white text-center focus:outline-none focus:border-red-500">বাংলাদেশে নতুন ডিজিটাল অটোমেশন ও ফটোকার্ড সিস্টেম চালু হয়েছে</textarea>

                <div class="space-y-3 pt-2 border-t border-slate-800">
                  <div>
                    <div class="flex justify-between text-xs text-slate-300 mb-1">
                      <span>হেডলাইন ফন্ট সাইজ:</span>
                      <span id="fontsize-val" class="font-bold text-amber-400">80px</span>
                    </div>
                    <input type="range" id="input-fontsize" min="40" max="120" value="80" oninput="drawCanvas()" class="w-full accent-red-600">
                  </div>

                  <div>
                    <div class="flex justify-between text-xs text-slate-300 mb-1">
                      <span>ডানে-বামে মার্জিন (অটো ১/২/৩ লাইন):</span>
                      <span id="margin-val" class="font-bold text-amber-400">120px</span>
                    </div>
                    <input type="range" id="input-margin" min="40" max="450" value="120" oninput="drawCanvas()" class="w-full accent-red-600">
                  </div>
                </div>
              </div>

              <!-- ৪. সোশ্যাল ও ওয়েবসাইট লিংক বার (১৫৬৩px - ১৬৪০px) -->
              <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-2">
                <div class="flex items-center justify-between">
                  <label class="text-xs font-bold text-emerald-400">
                    <i class="fa-solid fa-link"></i> ৪. ওয়েবসাইট ও সোশ্যাল লিংক বার (১৫৬৩px - ১৬৪০px)
                  </label>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="toggle-social-bar" checked onchange="drawCanvas()" class="sr-only peer">
                    <div class="w-8 h-4 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-blue-600"></div>
                    <span class="ml-2 text-[10px] text-slate-400 font-medium">চালু / বন্ধ</span>
                  </label>
                </div>
                <p class="text-[10px] text-slate-400">ফটোকার্ডে ওয়েবসাইটের ঠিকানা ও শুধু সোশ্যাল মিডিয়া আইকন দেখাবে—সোশ্যাল URL/নাম বা কাস্টম URL নয়। কোনো সোশ্যাল লিংক খালি রাখলে তার আইকনও দেখা যাবে না।</p>
                
                <div>
                  <label class="block text-[11px] text-slate-400 mb-0.5">ওয়েবসাইট লিংক (কার্ডে দেখানো হবে):</label>
                  <input type="text" id="link-website" value="DNBangla.com.bd" oninput="drawCanvas()" placeholder="DNBangla.com.bd" class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-1 text-xs text-slate-200">
